# Server Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Panel Database (Strictly isolated from client apps, e.g. diet_ghazipur)
# If Mongo is not present locally, DevPanel automatically falls back to embedded data storage
PANEL_MONGODB_URI=mongodb://127.0.0.1:27017/devpanel

# Security & Authentication
SESSION_SECRET=devpanel-super-secret-key-change-in-production-2026
ADMIN_EMAIL=admin@devpanel.local
ADMIN_PASSWORD=adminpassword123

# Workspace directory for Git repositories and isolated projects
WORKSPACE_ROOT=./workspaces

# GitHub Integration (Optional - HTTPS/SSH Git clone works without OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback

# Monitoring & Rate Limiting
MONITORING_ENABLED=true
RATE_LIMIT_ENABLED=true

