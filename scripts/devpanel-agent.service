[Unit]
Description=DevPanel Go Kernel Telemetry & Firewall Guard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/sushant-dev-panel
ExecStart=/var/www/sushant-dev-panel/bin/devpanel-agent
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

